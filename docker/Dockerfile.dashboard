# ═══════════════════════════════════════════════════════════════
# Angular 19 → Nginx static serve
# Build-time environment substitution via sed on environment.prod.ts
# ═══════════════════════════════════════════════════════════════

FROM node:20-alpine AS builder
WORKDIR /app

ARG API_URL=http://localhost/api
ARG INGRESS_URL=http://localhost

COPY package.json package-lock.json ./
COPY apps/dashboard/package.json ./apps/dashboard/
RUN npm ci --workspace=dashboard --include-workspace-root

COPY tsconfig.base.json ./
COPY apps/dashboard ./apps/dashboard

# ⚠️ Inject API_URL into environment.prod.ts BEFORE build.
# This matches Angular's fileReplacements (environment.prod.ts replaces environment.ts in prod build).
RUN set -eux; \
    ENV_FILE="apps/dashboard/src/environments/environment.prod.ts"; \
    test -f "$ENV_FILE" || (echo "❌ $ENV_FILE missing" && exit 1); \
    # Normalize the incoming API_URL: strip trailing slash if present
    TRIMMED_API_URL="$(echo "${API_URL}" | sed 's:/$::')"; \
    sed -i "s|__API_URL__|${TRIMMED_API_URL}|g" "$ENV_FILE"; \
    sed -i "s|__INGRESS_URL__|${INGRESS_URL}|g" "$ENV_FILE"; \
    # Fallback: replace hardcoded Vercel URLs if __API_URL__ pattern isn't present
    sed -i "s|https://relayon-api\.vercel\.app|${TRIMMED_API_URL}|g" "$ENV_FILE"; \
    sed -i "s|https://relayon-ingress\.vercel\.app|${INGRESS_URL}|g" "$ENV_FILE"; \
    echo "=== environment.prod.ts after substitution ==="; \
    cat "$ENV_FILE"

RUN npm run build --workspace=dashboard --configuration production

FROM nginx:1.27-alpine AS production
COPY docker/nginx-dashboard.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/dashboard/dist/dashboard/browser /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://localhost/health || exit 1