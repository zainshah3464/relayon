FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat openssl
WORKDIR /app

FROM base AS builder
COPY package.json package-lock.json ./
COPY packages/db/package.json ./packages/db/
COPY apps/workers/package.json ./apps/workers/
RUN npm ci --workspace=workers --include-workspace-root --ignore-scripts
COPY packages/db/prisma ./packages/db/prisma
RUN npx prisma generate --schema packages/db/prisma/schema.prisma
COPY tsconfig.base.json ./
COPY apps/workers ./apps/workers
RUN npm run build --workspace=workers

FROM base AS production
ENV NODE_ENV=production
RUN apk add --no-cache curl
COPY package.json package-lock.json ./
COPY packages/db/package.json ./packages/db/
COPY apps/workers/package.json ./apps/workers/
RUN npm ci --workspace=workers --include-workspace-root --omit=dev --ignore-scripts && \
    npm cache clean --force
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma ./node_modules/@prisma
COPY --from=builder /app/packages/db/prisma ./packages/db/prisma
COPY --from=builder /app/apps/workers/dist ./apps/workers/dist
RUN addgroup -S relayon && adduser -S relayon -G relayon && \
    chown -R relayon:relayon /app
USER relayon
EXPOSE 3003
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD curl -fsS http://localhost:3003/internal/health || exit 1
CMD ["node", "apps/workers/dist/workers/src/main.js"]