{
  "name": "relayon",
  "version": "0.1.0",
  "private": true,
  "description": "Relayon — serverless-native webhook relay platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node ./node_modules/prisma/build/index.js generate --schema=./packages/db/prisma/schema.prisma",
    "dev:dashboard": "npm run start --workspace=dashboard",
    "dev:api": "npm run dev --workspace=api",
    "dev:ingress": "npm run dev --workspace=ingress",
    "dev:workers": "npm run dev --workspace=workers",
    "build:dashboard": "npm run build --workspace=dashboard",
    "build:api": "npm run build --workspace=api",
    "build:ingress": "npm run build --workspace=ingress",
    "build:workers": "npm run build --workspace=workers",
    "db:generate": "npm run generate --workspace=db",
    "db:migrate": "npm run migrate --workspace=db",
    "db:deploy": "npm run migrate:deploy --workspace=db",
    "db:studio": "npm run studio --workspace=db",
    "db:reset": "npm run reset --workspace=db",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "smoke": "node scripts/smoke-test.mjs",
    "deploy:db": "npm run db:deploy"
  },
  "dependencies": {
    "prisma": "6.19.3",
    "@prisma/client": "6.19.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.0": true,
    "esbuild@0.25.12": true,
    "lmdb@3.2.6": true,
    "msgpackr-extract@3.0.4": true,
    "@parcel/watcher@2.6.0": true
  },
  "devDependencies": {},
  "engines": {
    "node": ">=20.0.0"
  }
}