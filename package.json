{
  "name": "relayon",
  "version": "0.1.0",
  "private": true,
  "description": "Relayon — serverless-native webhook relay platform",
  "author": "Zain Shah <zainshahzs110@gmail.com>",
  "license": "SEE LICENSE IN LICENSE",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "rxjs": "7.8.1",
    "@angular/core": "19.2.25",
    "@angular/common": "19.2.25",
    "@angular/compiler": "19.2.25",
    "@angular/forms": "19.2.25",
    "@angular/platform-browser": "19.2.25",
    "@angular/platform-browser-dynamic": "19.2.25",
    "@angular/router": "19.2.25",
    "@angular/animations": "19.2.25",
    "@angular/service-worker": "19.2.25"
  },
  "scripts": {
    "postinstall": "node -e \"const fs=require('fs');const p='./node_modules/prisma/build/index.js';if(fs.existsSync(p)){require('child_process').execSync('node '+p+' generate --schema=./packages/db/prisma/schema.prisma',{stdio:'inherit'})}else{console.log('[postinstall] Prisma not installed here — skipping generate')}\"",
    "dev:dashboard": "npm run start --workspace=dashboard",
    "dev:api": "npm run dev --workspace=api",
    "dev:ingress": "npm run dev --workspace=ingress",
    "dev:workers": "npm run dev --workspace=workers",
    "build:dashboard": "npm run build --workspace=dashboard",
    "build:api": "npm run build --workspace=api",
    "build:ingress": "npm run build --workspace=ingress",
    "build:workers": "npm run build --workspace=workers",
    "db:generate": "npm run generate --workspace=db",
    "db:migrate": "npm run migrate --workspace=db",
    "db:deploy": "npm run migrate:deploy --workspace=db",
    "db:studio": "npm run studio --workspace=db",
    "db:reset": "npm run reset --workspace=db",
    "db:rls": "node scripts/apply-rls.mjs",
    "workflows:pull": "node scripts/relayon-sync.mjs pull",
    "workflows:validate": "node scripts/relayon-sync.mjs validate",
    "workflows:push": "node scripts/relayon-sync.mjs push",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:ui": "vitest --config vitest.config.ts --ui",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:full": "playwright test test/e2e",
    "test:mutation": "stryker run",
    "test:mutation:critical": "stryker run --mutate \"apps/api/src/lib/crypto-box.ts,apps/workers/src/modules/egress/retry-policy.ts,apps/api/src/modules/quota/quota.service.ts\"",
    "test:load": "k6 run test/load/webhook-ingress.js",
    "test:load:sustained": "k6 run test/load/webhook-sustained.js",
    "test:load:burst": "k6 run test/load/webhook-burst.js",
    "test:load:delivery": "k6 run test/load/delivery-throughput.js",
    "test:all": "npm run test && npm run test:integration && npm run test:e2e",
    "smoke": "node scripts/smoke-test.mjs",
    "deploy:db": "npm run db:deploy",
    "sdk:sync": "npm run sync-all --workspace=@relayon/sdk",
    "sdk:generate": "npm run generate --workspace=@relayon/sdk",
    "sdk:build": "npm run build --workspace=@relayon/sdk",
    "sdk:publish": "npm publish --workspace=@relayon/sdk --access public"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "diff": "^9.0.0",
    "prisma": "6.19.3",
    "rxjs": "7.8.1"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true,
    "@swc/core@1.16.21": true,
    "lmdb@3.2.6": true,
    "msgpackr-extract@3.0.4": true,
    "@parcel/watcher@2.6.0": true
  },
  "devDependencies": {
    "@faker-js/faker": "^9.2.0",
    "@nestjs/testing": "^11.2.7",
    "@playwright/test": "^1.49.0",
    "@stryker-mutator/core": "^8.6.0",
    "@stryker-mutator/vitest-runner": "^8.6.0",
    "@swc/core": "^1.16.21",
    "@types/diff": "^7.0.2",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "dotenv": "^18.0.9",
    "js-yaml": "^4.1.0",
    "supertest": "^7.0.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}