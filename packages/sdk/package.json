{
  "name": "@relayon/sdk",
  "version": "3.0.0",
  "description": "Official Relayon SDK — typed client for the Relayon API",
  "keywords": [
    "relayon",
    "webhooks",
    "sdk",
    "openapi",
    "typescript"
  ],
  "homepage": "https://relayon.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zainshah3464/relayon.git",
    "directory": "packages/sdk"
  },
  "license": "MIT",
  "author": "Zain Shah <zainshahzs110@gmail.com>",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "sync": "node scripts/sync-spec.mjs",
    "generate": "openapi-ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "prepublishOnly": "npm run generate && npm run build",
    "sync-all": "npm run sync && npm run generate"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "prettier": "^3.10.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
