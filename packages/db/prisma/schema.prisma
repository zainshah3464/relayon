generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════

enum Plan {
  free
  pro
  enterprise
}

enum UserRole {
  owner
  admin
  viewer
}

enum SourceType {
  stripe
  github
  shopify
  slack
  generic
}

enum DestinationType {
  http
  slack
  sheets
  email
  discord
  airtable
  notion
  postgres
  mongodb
}

// ═══════════════════════════════════════════════════════════════
// CORE — TENANTS & USERS
// ═══════════════════════════════════════════════════════════════

model Tenant {
  id                    String   @id @default(uuid())
  name                  String
  slug                  String   @unique
  plan                  Plan     @default(free)
  quotaEventsPerMonth   Int      @default(10000) @map("quota_events_per_month")
  quotaAiTokensPerMonth Int      @default(100000) @map("quota_ai_tokens_per_month")
  currentPeriodStart    DateTime @default(now()) @map("current_period_start")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  users           User[]
  workflows       Workflow[]
  refreshTokens   RefreshToken[]
  apiKeys         ApiKey[]
  apiKeyRotations ApiKeyRotation[]
  usageCounters   UsageCounter[]

  @@map("tenants")
}

model User {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  role         UserRole  @default(owner)
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([tenantId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tenantId  String    @map("tenant_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ═══════════════════════════════════════════════════════════════
// WORKFLOWS & DESTINATIONS
// ═══════════════════════════════════════════════════════════════

model Workflow {
  id                  String     @id @default(uuid())
  tenantId            String     @map("tenant_id")
  name                String
  sourceType          SourceType @map("source_type")
  sourceConfig        Json       @default("{}") @map("source_config")
  enrichmentEnabled   Boolean    @default(false) @map("enrichment_enabled")
  enrichmentPrompt    String?    @map("enrichment_prompt")
  transformExpression String?    @map("transform_expression")
  routingRules        Json       @default("[]") @map("routing_rules")
  isActive            Boolean    @default(true) @map("is_active")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  destinations Destination[]
  schedule     WorkflowSchedule?
  versions     WorkflowVersion[]

  @@index([tenantId])
  @@map("workflows")
}

model Destination {
  id          String          @id @default(uuid())
  workflowId  String          @map("workflow_id")
  type        DestinationType
  name        String
  config      Json            @default("{}")
  enabled     Boolean         @default(true)
  retryPolicy Json            @default("{\"max_attempts\":5,\"backoff_ms\":[10000,30000,60000,300000,900000]}") @map("retry_policy")

  lastValidatedAt     DateTime? @map("last_validated_at")
  lastValidationOk    Boolean?  @map("last_validation_ok")
  lastValidationError String?   @map("last_validation_error")

  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@map("destinations")
}

// ═══════════════════════════════════════════════════════════════
// API KEYS
// ═══════════════════════════════════════════════════════════════

model ApiKey {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  name        String
  prefix      String    @unique
  keyHash     String    @unique @map("key_hash")
  scopes      String[]  @default([])
  environment String    @default("live") @map("environment")
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("api_keys")
}

// ═══════════════════════════════════════════════════════════════
// SCHEDULES & VERSIONS
// ═══════════════════════════════════════════════════════════════

model WorkflowSchedule {
  id              String    @id @default(uuid())
  workflowId      String    @unique @map("workflow_id")
  cronExpression  String    @map("cron_expression")
  timezone        String    @default("UTC")
  payloadTemplate Json      @default("{}") @map("payload_template")
  isActive        Boolean   @default(true) @map("is_active")
  lastRunAt       DateTime? @map("last_run_at")
  nextRunAt       DateTime  @map("next_run_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([isActive, nextRunAt])
  @@map("workflow_schedules")
}

model WorkflowVersion {
  id         String   @id @default(uuid())
  workflowId String   @map("workflow_id")
  tenantId   String   @map("tenant_id")
  version    Int
  snapshot   Json
  message    String?
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, version])
  @@index([tenantId, workflowId, version])
  @@map("workflow_versions")
}

// ═══════════════════════════════════════════════════════════════
// API KEY ROTATION AUDIT
// ═══════════════════════════════════════════════════════════════

model ApiKeyRotation {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  oldKeyId   String   @map("old_key_id")
  newKeyId   String   @map("new_key_id")
  rotatedBy  String?  @map("rotated_by")
  graceUntil DateTime @map("grace_until")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("api_key_rotations")
}

// ═══════════════════════════════════════════════════════════════
// USAGE / QUOTA (v1.8)
// ═══════════════════════════════════════════════════════════════

model UsageCounter {
  tenantId  String   @map("tenant_id")
  period    String
  metric    String
  count     BigInt   @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, period, metric])
  @@index([tenantId, period])
  @@map("usage_counters")
}