// ═══════════════════════════════════════════════════════════════
// v3.2 — binaryTargets for cross-platform deploy
//   native                          → local dev machine
//   rhel-openssl-3.0.x              → Vercel (RHEL)
//   linux-musl-arm64-openssl-3.0.x  → Docker Alpine ARM64 (Oracle Cloud)
//   linux-arm64-openssl-3.0.x       → Docker Debian ARM64
//   linux-musl-openssl-3.0.x        → Docker Alpine x86_64 (dev)
//   debian-openssl-3.0.x            → Docker Debian x86_64
// ═══════════════════════════════════════════════════════════════
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x", "linux-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  free
  pro
  enterprise
}

enum UserRole {
  owner
  admin
  viewer
}

enum SourceType {
  stripe
  github
  shopify
  slack
  generic
}

enum DestinationType {
  http
  slack
  sheets
  email
  discord
  airtable
  notion
  postgres
  mongodb
}

model Tenant {
  id                    String   @id @default(uuid())
  name                  String
  slug                  String   @unique
  plan                  Plan     @default(free)
  quotaEventsPerMonth   Int      @default(10000) @map("quota_events_per_month")
  quotaAiTokensPerMonth Int      @default(100000) @map("quota_ai_tokens_per_month")
  quotaMode             String   @default("hard") @map("quota_mode")
  currentPeriodStart    DateTime @default(now()) @map("current_period_start")

  // ── v2.0 billing (STRIPE TEST MODE ONLY) ─────────────────────
  stripeCustomerId     String?   @unique @map("stripe_customer_id")
  stripeSubscriptionId String?   @map("stripe_subscription_id")
  stripePriceId        String?   @map("stripe_price_id")
  subscriptionStatus   String    @default("none") @map("subscription_status")
  currentPeriodEnd     DateTime? @map("current_period_end")
  // ─────────────────────────────────────────────────────────────

  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  users           User[]
  workflows       Workflow[]
  refreshTokens   RefreshToken[]
  apiKeys         ApiKey[]
  apiKeyRotations ApiKeyRotation[]
  usageCounters   UsageCounter[]
  // ⚠️ v2.3 — chat + knowledge base
  chatSessions    ChatSession[]
  knowledgeChunks KnowledgeChunk[]
  // ⚠️ v2.5 — community marketplace
  communityPosts  CommunityPost[]
  // ⚠️ v3.0 — outbound webhooks (Standard Webhooks 1.0.0)
  webhookEndpoints WebhookEndpoint[]
  // ⚠️ v3.1 — CLI tunnel sessions
  tunnelSessions   TunnelSession[]
  // ⚠️ v3.3 — BYOK (Bring Your Own Key) integrations
  integrations     TenantIntegration[]

  @@map("tenants")
}

model User {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  email         String    @unique
  // ⚠️ v2.1 — nullable for OAuth-only users (no password set)
  passwordHash  String?   @map("password_hash")
  name          String
  role          UserRole  @default(owner)
  // ⚠️ v2.1 — existing users grandfathered as verified
  emailVerified Boolean   @default(true) @map("email_verified")
  // ⚠️ v2.1 — OAuth provider IDs
  googleId      String?   @unique @map("google_id")
  githubId      String?   @unique @map("github_id")
  // ⚠️ v2.2 — user's preferred UI + email language
  locale        String    @default("en")
  // ⚠️ v2.4 — super admin flag (platform-wide admin access)
  isSuperAdmin  Boolean   @default(false) @map("is_super_admin")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens      RefreshToken[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
  // ⚠️ v2.3 — chat sessions
  chatSessions       ChatSession[]
  // ⚠️ v2.5 — community marketplace
  communityPosts     CommunityPost[]
  communityReplies   CommunityReply[]
  communityLikes     CommunityLike[]

  @@index([tenantId])
  @@map("users")
}

// ⚠️ v2.1 — NEW model
model EmailVerification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verifications")
}

// ⚠️ v2.1 — NEW model
model PasswordReset {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_resets")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tenantId  String    @map("tenant_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Workflow {
  id                  String     @id @default(uuid())
  tenantId            String     @map("tenant_id")
  name                String
  sourceType          SourceType @map("source_type")
  sourceConfig        Json       @default("{}") @map("source_config")
  enrichmentEnabled   Boolean    @default(false) @map("enrichment_enabled")
  enrichmentPrompt    String?    @map("enrichment_prompt")
  transformExpression String?    @map("transform_expression")
  routingRules        Json       @default("[]") @map("routing_rules")
  isActive            Boolean    @default(true) @map("is_active")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  destinations Destination[]
  schedule     WorkflowSchedule?
  versions     WorkflowVersion[]

  @@index([tenantId])
  @@map("workflows")
}

model Destination {
  id          String          @id @default(uuid())
  workflowId  String          @map("workflow_id")
  tenantId    String          @map("tenant_id")
  type        DestinationType
  name        String
  config      Json            @default("{}")
  enabled     Boolean         @default(true)
  retryPolicy Json            @default("{\"max_attempts\":5,\"backoff_ms\":[10000,30000,60000,300000,900000]}") @map("retry_policy")

  lastValidatedAt     DateTime? @map("last_validated_at")
  lastValidationOk    Boolean?  @map("last_validation_ok")
  lastValidationError String?   @map("last_validation_error")

  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([tenantId])
  @@map("destinations")
}

model ApiKey {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  name        String
  prefix      String    @unique
  keyHash     String    @unique @map("key_hash")
  scopes      String[]  @default([])
  environment String    @default("live") @map("environment")
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("api_keys")
}

model WorkflowSchedule {
  id              String    @id @default(uuid())
  workflowId      String    @unique @map("workflow_id")
  tenantId        String    @map("tenant_id")
  cronExpression  String    @map("cron_expression")
  timezone        String    @default("UTC")
  payloadTemplate Json      @default("{}") @map("payload_template")
  isActive        Boolean   @default(true) @map("is_active")
  lastRunAt       DateTime? @map("last_run_at")
  nextRunAt       DateTime  @map("next_run_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([isActive, nextRunAt])
  @@index([tenantId])
  @@map("workflow_schedules")
}

model WorkflowVersion {
  id         String   @id @default(uuid())
  workflowId String   @map("workflow_id")
  tenantId   String   @map("tenant_id")
  version    Int
  snapshot   Json
  message    String?
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, version])
  @@index([tenantId, workflowId, version])
  @@map("workflow_versions")
}

model ApiKeyRotation {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  oldKeyId   String   @map("old_key_id")
  newKeyId   String   @map("new_key_id")
  rotatedBy  String?  @map("rotated_by")
  graceUntil DateTime @map("grace_until")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("api_key_rotations")
}

model UsageCounter {
  tenantId  String   @map("tenant_id")
  period    String
  metric    String
  count     BigInt   @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, period, metric])
  @@index([tenantId, period])
  @@map("usage_counters")
}

// ─────────────────────────────────────────────────────────────
// ⚠️ v2.3 — AI chat + knowledge base
// ─────────────────────────────────────────────────────────────

model ChatSession {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  title     String   @default("New chat")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([tenantId, userId, updatedAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  role      String
  content   String
  toolCalls Json?    @map("tool_calls")
  toolName  String?  @map("tool_name")
  createdAt DateTime @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

// ⚠️ NO vector column — using Postgres full-text search instead
model KnowledgeChunk {
  id         String   @id @default(uuid())
  tenantId   String?  @map("tenant_id")
  sourceType String   @map("source_type")
  sourceId   String   @map("source_id")
  title      String
  content    String
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, sourceType])
  @@index([sourceId])
  @@map("knowledge_chunks")
}

// ─────────────────────────────────────────────────────────────
// ⚠️ v2.4 — Phase A: analytics tracking + admin audit
// ─────────────────────────────────────────────────────────────

model PageEvent {
  id         BigInt   @id @default(autoincrement())
  tenantId   String?  @map("tenant_id")
  path       String
  referrer   String?
  ipHash     String?  @map("ip_hash")
  browser    String?
  os         String?
  device     String?
  country    String?
  sessionId  String   @map("session_id")
  eventType  String   @map("event_type")
  eventName  String?  @map("event_name")
  properties Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([path, createdAt])
  @@index([sessionId, createdAt])
  @@index([tenantId, createdAt])
  @@map("page_events")
}

model AdminAuditLog {
  id         String   @id @default(uuid())
  adminId    String   @map("admin_id")
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json     @default("{}")
  ipHash     String?  @map("ip_hash")
  // ⚠️ v2.9 — impersonation tracking
  impersonatedTenantId String?   @map("impersonated_tenant_id")
  sessionToken         String?   @map("session_token")
  expiresAt            DateTime? @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@index([impersonatedTenantId])
  @@map("admin_audit_logs")
}

// ─────────────────────────────────────────────────────────────
// ⚠️ v2.5 — Community marketplace (posts, replies, likes, flags)
// ─────────────────────────────────────────────────────────────

model CommunityPost {
  id          String    @id @default(uuid())
  tenantId    String?   @map("tenant_id")
  authorId    String?   @map("author_id")
  type        String
  title       String
  slug        String    @unique
  content     String
  tags        String[]  @default([])
  status      String    @default("published")
  likeCount   Int       @default(0) @map("like_count")
  replyCount  Int       @default(0) @map("reply_count")
  viewCount   Int       @default(0) @map("view_count")
  metadata    Json      @default("{}")
  // ⚠️ v2.8 — moderation
  autoHidden    Boolean   @default(false) @map("auto_hidden")
  autoHiddenAt  DateTime? @map("auto_hidden_at")
  pinnedUntil DateTime? @map("pinned_until")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  author  User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  tenant  Tenant?          @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  replies CommunityReply[]
  likes   CommunityLike[]  @relation("PostLikes")
  flags   CommunityFlag[]  @relation("PostFlags")

  @@index([type, status, createdAt])
  @@index([authorId, createdAt])
  @@index([tenantId])
  @@index([tags], type: Gin)
  @@map("community_posts")
}

model CommunityReply {
  id         String   @id @default(uuid())
  postId     String   @map("post_id")
  authorId   String   @map("author_id")
  parentId   String?  @map("parent_id")
  content    String
  status     String   @default("published")
  isSolution Boolean  @default(false) @map("is_solution")
  // ⚠️ v2.8 — moderation
  autoHidden    Boolean   @default(false) @map("auto_hidden")
  autoHiddenAt  DateTime? @map("auto_hidden_at")
  likeCount  Int      @default(0) @map("like_count")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  post     CommunityPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  author   User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent   CommunityReply?  @relation("ReplyParent", fields: [parentId], references: [id], onDelete: Cascade)
  children CommunityReply[] @relation("ReplyParent")
  likes    CommunityLike[]  @relation("ReplyLikes")
  flags    CommunityFlag[]  @relation("ReplyFlags")

  @@index([postId, createdAt])
  @@index([parentId])
  @@map("community_replies")
}

model CommunityLike {
  id        String   @id @default(uuid())
  postId    String?  @map("post_id")
  replyId   String?  @map("reply_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  post  CommunityPost?  @relation("PostLikes", fields: [postId], references: [id], onDelete: Cascade)
  reply CommunityReply? @relation("ReplyLikes", fields: [replyId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@unique([replyId, userId])
  @@index([userId])
  @@map("community_likes")
}

model CommunityFlag {
  id         String    @id @default(uuid())
  postId     String?   @map("post_id")
  replyId    String?   @map("reply_id")
  reporterId String    @map("reporter_id")
  reason     String
  detail     String?
  status     String    @default("pending")
  resolvedBy String?   @map("resolved_by")
  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  post  CommunityPost?  @relation("PostFlags", fields: [postId], references: [id], onDelete: Cascade)
  reply CommunityReply? @relation("ReplyFlags", fields: [replyId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("community_flags")
}

// ─────────────────────────────────────────────────────────────
// ⚠️ v2.8 — Moderation actions + announcement sharing
// ─────────────────────────────────────────────────────────────

model ModerationAction {
  id         String   @id @default(uuid())
  adminId    String   @map("admin_id")
  action     String
  postId     String?  @map("post_id")
  replyId    String?  @map("reply_id")
  flagId     String?  @map("flag_id")
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([adminId, createdAt])
  @@index([postId])
  @@index([replyId])
  @@map("moderation_actions")
}

model AnnouncementShare {
  id             String   @id @default(uuid())
  announcementId String   @map("announcement_id")
  platform       String
  status         String
  externalId     String?  @map("external_id")
  error          String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([announcementId, platform])
  @@map("announcement_shares")
}

// ═══════════════════════════════════════════════════════════════
// v3.0 Wave 3 — Outbound webhooks (Standard Webhooks 1.0.0)
// ═══════════════════════════════════════════════════════════════

model WebhookEndpoint {
  id                   String    @id @default(uuid())
  tenantId             String    @map("tenant_id")
  url                  String
  secret               String
  description          String?
  eventTypes           String[]  @default([]) @map("event_types")
  isActive             Boolean   @default(true) @map("is_active")
  consecutiveFailures  Int       @default(0) @map("consecutive_failures")
  lastSuccessAt        DateTime? @map("last_success_at")
  lastFailureAt        DateTime? @map("last_failure_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@map("webhook_endpoints")
}

model OutboxEvent {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  eventType     String    @map("event_type")
  payload       Json
  status        String    @default("pending")
  attemptCount  Int       @default(0) @map("attempt_count")
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
  lastError     String?   @map("last_error")
  deliveredAt   DateTime? @map("delivered_at")
  expiresAt     DateTime  @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt])
  @@index([tenantId, createdAt])
  @@index([expiresAt])
  @@map("outbox_events")
}

// ═══════════════════════════════════════════════════════════════
// v3.0 Wave 3 — DB-backed feature flags
// ═══════════════════════════════════════════════════════════════

model FeatureFlag {
  key             String   @id
  description     String?
  isEnabled       Boolean  @default(false) @map("is_enabled")
  rolloutPct      Int      @default(0) @map("rollout_pct") // 0-100
  tenantOverrides Json     @default("{}") @map("tenant_overrides") // { "tenant-uuid": true|false }
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

// ═══════════════════════════════════════════════════════════════
// v3.1 — CLI Tunnel sessions
// ═══════════════════════════════════════════════════════════════

model TunnelSession {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  sessionId  String   @unique @map("session_id")
  targetPort Int      @map("target_port")
  label      String?
  isActive   Boolean  @default(true) @map("is_active")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@index([expiresAt])
  @@map("tunnel_sessions")
}

// ═══════════════════════════════════════════════════════════════
// v3.5 — BYOK (Bring Your Own Key) integrations
// ═══════════════════════════════════════════════════════════════

model TenantIntegration {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  provider         String    // 'groq' | 'openai' | 'anthropic' | 'resend'
  encryptedKey     String    @map("encrypted_key")
  model            String?
  isActive         Boolean   @default(true) @map("is_active")
  lastValidatedAt  DateTime? @map("last_validated_at")
  lastValidationOk Boolean?  @map("last_validation_ok")
  validationError  String?   @map("validation_error")
  lastUsedAt       DateTime? @map("last_used_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@index([tenantId, isActive])
  @@map("tenant_integrations")
}