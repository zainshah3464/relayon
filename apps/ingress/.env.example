# ═══════════════════════════════════════════════════════════════
# APP
# ═══════════════════════════════════════════════════════════════
NODE_ENV=development
INGRESS_PORT=3002
CORS_ORIGIN=http://localhost:4200

# ═══════════════════════════════════════════════════════════════
# DATABASE — Neon (same as API)
# ═══════════════════════════════════════════════════════════════
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ═══════════════════════════════════════════════════════════════
# REDIS — Upstash (TCP URL, must start with rediss://)
# https://console.upstash.com → Connect → copy the rediss:// URL
# ═══════════════════════════════════════════════════════════════
UPSTASH_REDIS_TCP_URL=rediss://default:xxx@xxx.upstash.io:6379

# ═══════════════════════════════════════════════════════════════
# SECURITY
# Generate IP_HASH_SALT: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# ═══════════════════════════════════════════════════════════════
IP_HASH_SALT=replace-with-16-plus-random-chars
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300

SENTRY_DSN=