# ═══════════════════════════════════════════════════════════════
# APP
# ═══════════════════════════════════════════════════════════════
NODE_ENV=development
API_PORT=3001
CORS_ORIGIN=http://localhost:4200

# ═══════════════════════════════════════════════════════════════
# DATABASE — Neon PostgreSQL (required)
# Same connection string as packages/db/.env
# ═══════════════════════════════════════════════════════════════
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ═══════════════════════════════════════════════════════════════
# JWT (required)
# Generate JWT_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ═══════════════════════════════════════════════════════════════
JWT_SECRET=replace-with-32-plus-random-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ═══════════════════════════════════════════════════════════════
# MONGODB — same as workers
# ═══════════════════════════════════════════════════════════════
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=relayon

# ═══════════════════════════════════════════════════════════════
# CONNECTOR CREDENTIAL ENCRYPTION (required for v1.3+)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be identical in apps/api and apps/workers
# ═══════════════════════════════════════════════════════════════
CONNECTOR_ENCRYPTION_KEY=replace-with-64-hex-chars

    # ═══════════════════════════════════════════════════════════════
    # STRIPE — TEST MODE ONLY (zero real charges)
    # Get from: https://dashboard.stripe.com/test/apikeys
    # Live keys (sk_live_...) are REFUSED by StripeService — project is free
    # ═══════════════════════════════════════════════════════════════
    STRIPE_SECRET_KEY=sk_test_...
    STRIPE_WEBHOOK_SECRET=whsec_...
    STRIPE_PRICE_ID_PRO=price_...
    APP_ORIGIN=http://localhost:4200

# ═══════════════════════════════════════════════════════════════
# WORKERS PROXY — for schedule run-now and other internal calls
# ═══════════════════════════════════════════════════════════════
WORKERS_URL=http://localhost:3003
CRON_SECRET=<paste-same-value-as-workers>

# ═══════════════════════════════════════════════════════════════
# UPSTASH REDIS (already for ingress/workers — API needs it now for OAuth)
# ═══════════════════════════════════════════════════════════════
UPSTASH_REDIS_TCP_URL=rediss://default:xxx@xxx.upstash.io:6379

# ═══════════════════════════════════════════════════════════════
# OAUTH (optional per-provider — leave blank to disable)
# ═══════════════════════════════════════════════════════════════
API_URL=http://localhost:3001
APP_ORIGIN=http://localhost:4200

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# ═══════════════════════════════════════════════════════════════
# GMAIL SMTP (Nodemailer — free 500 emails/day)
# Generate App Password: https://myaccount.google.com/apppasswords
# Requires 2-Step Verification ON
# ═══════════════════════════════════════════════════════════════
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM=Relayon <your.email@gmail.com>

# ═══════════════════════════════════════════════════════════════
# AI ASSISTANT — Groq only (no embeddings needed, uses Postgres FTS)
# ═══════════════════════════════════════════════════════════════
GROQ_API_KEY=gsk_xxx
INGRESS_URL=http://localhost:3002

# OPTIONAL — https://sentry.io (free tier)
SENTRY_DSN=

API_KEY_PEPPER=change-me-to-a-random-32-char-string

