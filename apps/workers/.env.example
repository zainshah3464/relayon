# ═══════════════════════════════════════════════════════════════
# APP
# ═══════════════════════════════════════════════════════════════
NODE_ENV=development
WORKERS_PORT=3003

# ═══════════════════════════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════════════════════════
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=relayon

# ═══════════════════════════════════════════════════════════════
# REDIS — Upstash TCP URL (must be rediss://)
# ═══════════════════════════════════════════════════════════════
UPSTASH_REDIS_TCP_URL=rediss://default:xxx@xxx.upstash.io:6379

# ═══════════════════════════════════════════════════════════════
# AI — GROQ
# https://console.groq.com  → API Keys → Create
# Free tier models: llama-3.3-70b-versatile, llama-3.1-8b-instant
# ═══════════════════════════════════════════════════════════════
GROQ_API_KEY=gsk_xxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=1024
GROQ_TEMPERATURE=0.2

# ═══════════════════════════════════════════════════════════════
# WORKER BEHAVIOR
# ═══════════════════════════════════════════════════════════════
BATCH_SIZE=5
TIME_BUDGET_MS=8000

# ═══════════════════════════════════════════════════════════════
# SECURITY
# Generate CRON_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ═══════════════════════════════════════════════════════════════
CRON_SECRET=replace-with-32-plus-random-chars

SENTRY_DSN=
GROQ_TIMEOUT_MS=20000
ADAPTER_TIMEOUT_MS=15000